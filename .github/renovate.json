{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>BSStudio/renovate-config",
    "github>BSStudio/renovate-config:monthly",
    "github>BSStudio/renovate-config:approve-merges"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^scripts/.*\\.sh$/"],
      "matchStrings": [
        "docker run",
        "(?<depName>([a-zA-Z0-9.-]+/)?[a-zA-Z0-9-]+/[a-zA-Z0-9-]+):(?<currentValue>[v0-9.]+)"
      ],
      "matchStringsStrategy": "combination"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/(^|/)Chart\\.yaml$/"],
      "matchStrings": [
        "appVersion:\\s+(?<currentValue>.*)",
        "#\\s*image:\\s+(?<depName>.*)"
      ],
      "matchStringsStrategy": "combination"
    }
  ],
  "packageRules": [
    {
      "description": "Group all minor and patch updates together for applications.",
      "addLabels": ["application"],
      "groupName": "all non-major application updates",
      "groupSlug": "all-minor-patch-application",
      "matchFileNames": ["**/!(*.sh)"],
      "matchManagers": [
        "custom.regex",
        "helm-requirements",
        "helm-values",
        "helmv3"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "postUpdateOptions": ["helmUpdateSubChartArchives"]
    },
    {
      "description": "Group all minor and patch updates together for development dependencies. GitHub Actions stay in the shared preset's group, which merges unattended.",
      "addLabels": ["development"],
      "groupName": "all non-major development dependencies",
      "groupSlug": "all-minor-patch-development",
      "matchFileNames": ["**/!(Chart.yaml)"],
      "matchManagers": ["custom.regex", "pip_requirements", "pre-commit"],
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
}
